  - m_Id: 8939771310080
    m_Localized: "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12097121726464
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E \u043C\u044B
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0430\u043F\u0435\u0440\u0442\u044B
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12332262797312
    m_Localized: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0432\u0435\u0440\u0438
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B, \u043D\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u043A\u043B\u044E\u0447\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 12691416854528
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C
      \u0442\u043E\u0442 \u0442\u0440\u0443\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 16499177992192
    m_Localized: "\u0418\u0437\u0432\u0438\u043D\u0438, \u0435\u0441\u043B\u0438
      \u043D\u0430\u043F\u0443\u0433\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 16523471400960
    m_Localized: "\u041D\u0435 \u0441\u043E\u0432\u0435\u0442\u0443\u044E \u0438\u0434\u0442\u0438
      \u0432 \u044D\u0442\u0443 \u0434\u0432\u0435\u0440\u044C, \u0442\u0430\u043C
      \u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 16546632347648
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0431\u0437\u0430\u0432\u0435\u0441\u0442\u0438\u0441\u044C
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 16561056559104
    m_Localized: "\u041F\u043E\u0434\u0432\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u0442\u0430\u0436
      \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D, \u043D\u043E \u044F \u0432\u0438\u0434\u0435\u043B
      \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E \u0442\u0440\u0443\u0431\u0443
      \u0432 \u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0438\u0442\u044C
      \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 17945063632896
    m_Localized: "\u041D\u0435\u0442, \u044F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u043F\u0440\u044B\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18204770742272
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u043A\u0430\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0432\u0435\u0441\u044C \u044D\u0442\u043E\u0442 \u043A\u043E\u0448\u043C\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 18217647255552
    m_Localized: "\u041E\u043D\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439, \u0433\u0434\u0435 \u043C\u044B
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18248815128576
    m_Localized: "\u0412 \u0441\u0430\u043C\u043E \u043B\u043E\u0433\u043E\u0432\u043E
      \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043D\u0435 \u0442\u0430\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E, \u0435\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0421\u0442\u0440\u0430\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 18267374923776
    m_Localized: "\u0415\u0451 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0421\u0442\u0440\u0430\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 18290066108416
    m_Localized: "\u041D\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C \u043A\u0430\u043A \u0435\u0433\u043E
      \u043E\u0431\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 38523296329728
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044D\u0442\u043E
      \u043C\u043E\u0439 \u043A\u043E\u043D\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 38545278676992
    m_Localized: "\u0412\u044B\u0440\u0435\u0436\u044C \u043C\u043E\u0451 \u0441\u0435\u0440\u0434\u0446\u0435
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0435\u0433\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0421\u0442\u0440\u0430\u0436\u0430
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0430 1-\u043E\u043C
      \u044D\u0442\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 38562311745536
    m_Localized: "\u0412\u044B\u0440\u0435\u0436\u044C \u043C\u043E\u0451 \u0441\u0435\u0440\u0434\u0446\u0435
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0435\u0433\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0421\u0442\u0440\u0430\u0436\u0430
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0430 1-\u043E\u043C
      \u044D\u0442\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 54893106999296
    m_Localized: "... \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043C\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 54995674509312
    m_Localized: "\u042F \u043D\u0430\u0445\u043E\u0436\u0443\u0441\u044C \u0432
