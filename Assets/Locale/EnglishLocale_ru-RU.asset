  - m_Id: 310152266035200
    m_Localized: "\u0410\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
      \u043F\u0440\u043E\u0436\u0438\u0433\u0430\u0442\u044C \u0434\u0435\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u043B\u043E\u0442\u044C. \u0417\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
      \u043B\u0443\u0447\u0430\u043C\u0438 \u0441\u043E\u043B\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 310191029792768
    m_Localized: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u0438\u044E
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430, \u043D\u0443\u0436\u043D\u043E
      \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0435\u0433\u043E \u0432
      \u0432\u043E\u0434\u0443. \u041F\u043E\u0433\u0440\u0443\u0437\u043A\u0430
      \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u0430\u043D\u0435\u043B\u0438
      \u043D\u0430 \u043A\u0440\u044B\u0448\u0435. \u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
