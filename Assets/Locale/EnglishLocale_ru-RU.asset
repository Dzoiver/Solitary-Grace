      m_Items: []
  - m_Id: 86930119503872
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 87329429827584
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 87274769657856
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87176488726528
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438? \u0412\u0435\u0441\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 87062974083072
    m_Localized: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87024969494528
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 86995638726656
    m_Localized: "\u0418\u0437\u0443\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 89038700982272
    m_Localized: "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 92251311353856
    m_Localized: "\u041B\u0435\u0447\u0435\u0431\u043D\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 110236826644480
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E
      \u0430\u043D\u043E\u043D\u0438\u043C\u043D\u043E \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u043C-\u0442\u043E \u0441\u0443\u043F\u0435\u0440 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u043C.
      \u041A\u0430\u043A\u0430\u044F \u0440\u0430\u0437\u043D\u0438\u0446\u0430,
      \u0435\u0441\u043B\u0438 \u0432\u0430\u043C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043D\u0435 \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 111123800305664
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439, \u043A\u0442\u043E \u0432\u0438\u0434\u0438\u0442
      \u044D\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u043C\u043E\u0438 \u043B\u0443\u0447\u0438 \u0434\u043E\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 111153475006464
    m_Localized: "\u0413\u043E\u0440\u043D\u0438\u0447\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
