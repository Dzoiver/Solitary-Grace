  - m_Id: 4501259178782720
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 4519801043333120
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E \u043B\u0438\u0444\u0442
      \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 4886388170600448
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0430\u044F \u043B\u0435\u043D\u0442\u0430.
      \u042F \u0441\u043C\u043E\u0433\u0443 \u043F\u0435\u0440\u0435\u0440\u0435\u0437\u0430\u0442\u044C
      \u0435\u0451 \u0447\u0435\u043C-\u0442\u043E \u043E\u0441\u0442\u0440\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5036612851642368
    m_Localized: "\u0417\u0430\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u0439
      \u0414 \u043D\u0435 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u0435\u043D.
      \u0417\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043B\u0438
      \u043E\u043D \u0442\u0430\u043A\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F?
      \u041A\u043E\u043B\u043B\u0435\u0433\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u043E\u043D \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u0442\u0438\u0440\u0430\u0442\u044C\u0441\u044F \u0432 \u0434\u043E\u0432\u0435\u0440\u0438\u0435.
      \u0418 \u0432\u0441\u0451 \u0436\u0435, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, 
      \u043E\u043D \u043D\u0435 \u043E\u043F\u0430\u0441\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5101652392849408
    m_Localized: "\u0410 \u0435\u0449\u0451 \u0447\u0442\u043E-\u0442\u043E \u0432\u0430\u0436\u043D\u043E\u0435
      \u0432\u044B\u043F\u0430\u043B\u043E \u0443 \u043C\u0435\u043D\u044F \u043F\u0440\u044F\u043C\u043E
      \u0438\u0437 \u043E\u043A\u043D\u0430, \u043D\u0443\u0436\u043D\u043E \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430\u0431\u0440\u0430\u0442\u044C. \u0415\u0441\u043B\u0438 \u043A\u043E\u043C\u0443-\u0442\u043E
      \u043D\u0443\u0436\u043D\u043E, \u0442\u043E \u043A\u043B\u044E\u0447 \u043E\u0445\u0440\u0430\u043D\u044B
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0432 \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6180917892919296
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 8376501697556480
    m_Localized: "\u041E\u043D\u0430 \u043C\u0435\u0440\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 8420848887443456
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0432\u043E\u0434\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F, \u043D\u0443\u0436\u043D\u043E
      \u0441\u043A\u043E\u0440\u0435\u0435 \u0443\u0445\u043E\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10143676577918976
    m_Localized: "\u0417\u0430\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u0439
      \u0421. \u041D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0436\u0438\u0432\u043E\u0439 \u043F\u043B\u043E\u0442\u044C\u044E, \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438
      \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0441\u0442\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442. "
    m_Metadata:
      m_Items: []
  - m_Id: 10148097210757120
    m_Localized: "\u0412 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0435. \u0421\u0440\u0430\u0437\u0443
      \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u043F\u0430\u0436\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u043E\u0433\u043E
      \u0411. \u0418\u043D\u0436\u0435\u043D\u0435\u0440\u044B \u0431\u044B\u043B\u0438
      \u0432\u044B\u0437\u0432\u0430\u043D\u044B \u0432 \u0441\u0440\u043E\u0447\u043D\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u0434\u043B\u044F \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u043F\u043E\u043B\u043E\u043C\u043E\u043A. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u044B
      \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0438,
      \u043D\u043E \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u043A\u0440\u0430\u0439\u043D\u0435
      \u0448\u0430\u0442\u043A\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10151691670564864
    m_Localized: "\u041C\u044B \u0442\u0432\u043E\u0438 \u0433\u043B\u0430\u0437\u0430,
      \u043C\u044B \u0441\u043B\u0435\u0434\u0438\u043C \u0437\u0430 \u0442\u043E\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10151803318743040
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u0431\u043B\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u043C\u043E\u0433\u043B\u0438
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u0431\u044F
      \u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10151863808995328
